# Скопіюйте в .env і заповніть. Усі значення необов'язкові: без доступу до Airtable інструмент
# так само збирає, зводить лоти та експортує в CSV.

# Де лежить база SQLite
LOT_HISTORY_DB=data/lots.sqlite3

# Пауза між запитами до API Prozorro.Продажі, секунди
LOT_HISTORY_DELAY=0.5

# Таблиця Airtable для перевірки (токен: https://airtable.com/create/tokens).
# Права токена: data.records:read, data.records:write, schema.bases:read, schema.bases:write
AIRTABLE_TOKEN=
# Частина адреси бази, що починається з "app"
AIRTABLE_BASE_ID=
AIRTABLE_TABLE=Lots
